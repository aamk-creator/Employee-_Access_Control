<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_access_group_search" model="ir.ui.view">
        <field name="name">employee.access.group.search</field>
        <field name="model">employee.access.group</field>
        <field name="arch" type="xml">
            <search string="Groups">
                <field name="name"/>
                <field name="application_id"/>
                <field name="display_type"/>
                <field name="company_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_application" string="Application" context="{'group_by': 'application_id'}"/>
                    <filter name="group_by_display_type" string="Display Type" context="{'group_by': 'display_type'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_access_group_tree" model="ir.ui.view">
        <field name="name">employee.access.group.list</field>
        <field name="model">employee.access.group</field>
        <field name="arch" type="xml">
            <tree string="Groups" default_order="sequence, name">
                <field name="name"/>
                <field name="application_id"/>
                <field name="description" optional="show"/>
                <field name="sequence"/>
                <field name="default_role"/>
                <field name="display_type"/>
                <field name="company_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_access_group_form" model="ir.ui.view">
        <field name="name">employee.access.group.form</field>
        <field name="model">employee.access.group</field>
        <field name="arch" type="xml">
            <form string="Group">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="display_type"/>
                            <field name="application_id"
                                   context="{'show_system_in_name': True}"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="description"
                                   placeholder="Describe the access granted by this group..."/>
                        </group>
                        <group>
                            <field name="system_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="default_role"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_access_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">employee.access.group</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="employee_access_control.view_employee_access_group_tree"/>
        <field name="search_view_id" ref="employee_access_control.view_employee_access_group_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an application role or privileged-access checkbox.</p>
        </field>
    </record>
</odoo>
