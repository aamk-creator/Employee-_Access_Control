<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_access_system_tag_search" model="ir.ui.view">
        <field name="name">employee.access.system.tag.search</field>
        <field name="model">employee.access.system.tag</field>
        <field name="arch" type="xml">
            <search string="System Tags">
                <field name="name"/>
                <field name="company_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_access_system_tag_tree" model="ir.ui.view">
        <field name="name">employee.access.system.tag.tree</field>
        <field name="model">employee.access.system.tag</field>
        <field name="arch" type="xml">
            <tree string="System Tags">
                <field name="name"/>
                <field name="company_id"/>
                <field name="color" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_access_system_tag_form" model="ir.ui.view">
        <field name="name">employee.access.system.tag.form</field>
        <field name="model">employee.access.system.tag</field>
        <field name="arch" type="xml">
            <form string="System Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_access_system_tag" model="ir.actions.act_window">
        <field name="name">System Tags</field>
        <field name="res_model">employee.access.system.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="employee_access_control.view_employee_access_system_tag_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a system tag to classify managed systems.</p>
        </field>
    </record>
</odoo>
