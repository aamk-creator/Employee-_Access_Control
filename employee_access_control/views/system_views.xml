<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_access_system_search" model="ir.ui.view">
        <field name="name">employee.access.system.search</field>
        <field name="model">employee.access.system</field>
        <field name="arch" type="xml">
            <search string="Systems">
                <field name="name"/>
                <field name="company_id"/>
                <field name="owner_id"/>
                <field name="facility_ids"/>
                <field name="tag_ids"/>
                <field name="mail_recipient_ids"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_access_system_tree" model="ir.ui.view">
        <field name="name">employee.access.system.tree</field>
        <field name="model">employee.access.system</field>
        <field name="arch" type="xml">
            <list string="Systems" default_order="sequence, name" import="0" export_xlsx="0">
                <field name="name" string="System Name"/>
                <field name="total_licensed_users"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_employee_access_system_form" model="ir.ui.view">
        <field name="name">employee.access.system.form</field>
        <field name="model">employee.access.system</field>
        <field name="arch" type="xml">
            <form string="System">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="facility_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="total_licensed_users"/>
                            <field name="mail_recipient_ids" widget="many2many_tags_email" placeholder="vendor@mail.com"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_access_system" model="ir.actions.act_window">
        <field name="name">Systems</field>
        <field name="res_model">employee.access.system</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="employee_access_control.view_employee_access_system_tree"/>
        <field name="search_view_id" ref="employee_access_control.view_employee_access_system_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a managed system for future access requests.</p>
        </field>
    </record>
</odoo>
