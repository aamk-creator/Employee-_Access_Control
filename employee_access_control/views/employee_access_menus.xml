<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_access_company_tree" model="ir.ui.view">
        <field name="name">res.company.employee.access.tree</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="Companies" import="0" export_xlsx="0">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_employee_access_company_search" model="ir.ui.view">
        <field name="name">res.company.employee.access.search</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <search string="Companies">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_employee_access_companies" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="employee_access_control.view_employee_access_company_tree"/>
        <field name="search_view_id" ref="employee_access_control.view_employee_access_company_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_employee_access_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">employee_access_control.dashboard</field>
    </record>

    <record id="action_employee_access_requests" model="ir.actions.client">
        <field name="name">Requests</field>
        <field name="tag">display_notification</field>
        <field name="params" eval="{
            'title': 'Requests',
            'message': 'Use the Odoo User Account Requests menu to create and manage requests.',
            'type': 'info',
            'sticky': False,
        }"/>
    </record>

    <record id="action_employee_access_asset_requests" model="ir.actions.client">
        <field name="name">Asset Requests</field>
        <field name="tag">display_notification</field>
        <field name="params" eval="{
            'title': 'Asset Requests',
            'message': 'Asset request workflows will be available in a later phase.',
            'type': 'info',
            'sticky': False,
        }"/>
    </record>

    <menuitem
        id="menu_employee_access_root"
        name="Employee Access Control"
        action="employee_access_control.action_employee_access_system"
        sequence="80"
        groups="employee_access_control.group_employee_access_user"
