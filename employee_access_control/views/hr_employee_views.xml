<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_employee_access" model="ir.ui.view">
        <field name="name">hr.employee.form.employee.access</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']//field[@name='identification_id']/parent::group"
                   position="after">
                <group string="Custom Fields" name="employee_access_custom_fields">
                    <field name="employee_access_fingerprint_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
